{
  "name": "turbohaven",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "content": "node rules/scripts/build-content.ts",
    "dev": "npm run content && vite",
    "build": "prettier --check . && npm run content && tsc --noEmit -p . && tsc --noEmit -p rules && tsc --noEmit -p scenarios && vite build --base ./ --outDir dist --emptyOutDir && vite build rules && vite build scenarios",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run --root rules"
  },
  "dependencies": {
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/germania-one": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "markdown-it": "^15.0.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
